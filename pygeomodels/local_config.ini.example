# Local development configuration
# Copy this file to local_config.ini and modify for your local development
# This file is gitignored and will not be committed

[FEATURE_FLAGS]
# Local development: enable all tools for testing
enable_terrain_analysis_tools = true
enable_model_management_tools = true

# Test authentication token for local development
# WARNING: Only for development testing! Never commit real tokens to git!
# Get your token from Keycloak or use existing access token
# Leave empty to require proper authentication from request headers
test_bearer_token = your_test_token_here

# You can override other settings from default_config.ini here
# For example:
# [SERVICE]
# modelmanager_url = http://localhost:7504